{
  "info": {
    "name": "Shortz-App API",
    "description": "Coleção de testes da API do Shortz-App, convertida a partir do sistema server-side original (EJS + sessão) para uma API REST em JSON, autenticada via JWT.\n\nComo usar:\n1. Ajuste a variável `base_url` se sua API não estiver em http://localhost:3000/api.\n2. Rode 'Registrar usuário' e depois 'Login' — o token é salvo automaticamente na variável `token` e usado em todas as rotas protegidas (header Authorization: Bearer {{token}}).\n3. Rode 'Upload de vídeo' — o `video_id` retornado é salvo automaticamente e reutilizado nas demais rotas de vídeo.\n4. Rode 'Criar playlist' — o `playlist_id` é salvo automaticamente.\n5. Para testar follow/like/comment em outro usuário, crie uma segunda conta e ajuste manualmente a variável `target_user_id`.\n6. Para testar as rotas de /admin, promova um usuário a admin diretamente no banco (isAdmin = true) e faça login com ele.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:3000/api" },
    { "key": "token", "value": "" },
    { "key": "video_id", "value": "" },
    { "key": "playlist_id", "value": "" },
    { "key": "username", "value": "" },
    { "key": "target_user_id", "value": "1" },
    { "key": "notification_id", "value": "1" },
    { "key": "report_id", "value": "1" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Autenticação",
      "item": [
        {
          "name": "Registrar usuário",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"joaotest\",\n  \"email\": \"joao@teste.com\",\n  \"password\": \"123456\",\n  \"confirmPassword\": \"123456\",\n  \"fullName\": \"João Teste\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const body = pm.response.json();",
                  "    pm.collectionVariables.set('username', body.data.username);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"login\": \"joaotest\",\n  \"password\": \"123456\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const body = pm.response.json();",
                  "    pm.collectionVariables.set('token', body.data.token);",
                  "    pm.collectionVariables.set('username', body.data.user.username);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout",
          "request": { "method": "POST", "url": "{{base_url}}/logout" }
        }
      ]
    },
    {
      "name": "Usuário",
      "item": [
        {
          "name": "Meu perfil",
          "request": { "method": "GET", "url": "{{base_url}}/profile/me" }
        },
        {
          "name": "Atualizar perfil",
          "request": {
            "method": "PUT",
            "url": "{{base_url}}/profile/me",
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "fullName", "value": "João Teste Atualizado", "type": "text" },
                { "key": "bio", "value": "Minha nova bio", "type": "text" },
                { "key": "profilePicture", "type": "file", "src": "" }
              ]
            }
          }
        },
        {
          "name": "Perfil público (username)",
          "request": { "method": "GET", "url": "{{base_url}}/profile/{{username}}" }
        },
        {
          "name": "Feed",
          "request": { "method": "GET", "url": "{{base_url}}/feed?page=1&limit=20" }
        }
      ]
    },
    {
      "name": "Vídeos",
      "item": [
        {
          "name": "Upload de vídeo",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/videos/upload",
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "title", "value": "Meu primeiro vídeo", "type": "text" },
                { "key": "description", "value": "Descrição do vídeo de teste", "type": "text" },
                { "key": "video", "type": "file", "src": "" },
                { "key": "thumbnail", "type": "file", "src": "" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const body = pm.response.json();",
                  "    pm.collectionVariables.set('video_id', body.data.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Detalhes do vídeo",
          "request": { "method": "GET", "url": "{{base_url}}/videos/{{video_id}}" }
        },
        {
          "name": "Stream do vídeo",
          "request": { "method": "GET", "url": "{{base_url}}/videos/{{video_id}}/stream" }
        },
        {
          "name": "Meus vídeos",
          "request": { "method": "GET", "url": "{{base_url}}/my-videos" }
        },
        {
          "name": "Vídeo para edição",
          "request": { "method": "GET", "url": "{{base_url}}/videos/{{video_id}}/edit" }
        },
        {
          "name": "Atualizar vídeo",
          "request": {
            "method": "PUT",
            "url": "{{base_url}}/videos/{{video_id}}",
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "title", "value": "Título atualizado", "type": "text" },
                { "key": "description", "value": "Descrição atualizada", "type": "text" },
                { "key": "thumbnail", "type": "file", "src": "" }
              ]
            }
          }
        },
        {
          "name": "Excluir vídeo",
          "request": { "method": "DELETE", "url": "{{base_url}}/videos/{{video_id}}" }
        },
        {
          "name": "Vídeos de quem eu sigo",
          "request": { "method": "GET", "url": "{{base_url}}/following-videos" }
        }
      ]
    },
    {
      "name": "Curtidas",
      "item": [
        {
          "name": "Curtir/descurtir vídeo",
          "request": { "method": "POST", "url": "{{base_url}}/videos/{{video_id}}/toggle-like" }
        },
        {
          "name": "Status de curtida",
          "request": { "method": "GET", "url": "{{base_url}}/videos/{{video_id}}/like-status" }
        },
        {
          "name": "Vídeos curtidos",
          "request": { "method": "GET", "url": "{{base_url}}/liked-videos" }
        }
      ]
    },
    {
      "name": "Comentários",
      "item": [
        {
          "name": "Adicionar comentário",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/videos/{{video_id}}/comments",
            "body": { "mode": "raw", "raw": "{\n  \"content\": \"Muito bom esse vídeo!\"\n}" }
          }
        },
        {
          "name": "Listar comentários",
          "request": { "method": "GET", "url": "{{base_url}}/videos/{{video_id}}/comments" }
        }
      ]
    },
    {
      "name": "Seguidores",
      "item": [
        {
          "name": "Seguir/deixar de seguir",
          "request": { "method": "POST", "url": "{{base_url}}/users/{{target_user_id}}/toggle-follow" }
        },
        {
          "name": "Status de follow",
          "request": { "method": "GET", "url": "{{base_url}}/users/{{target_user_id}}/follow-status" }
        },
        {
          "name": "Seguidores de um usuário",
          "request": { "method": "GET", "url": "{{base_url}}/users/{{target_user_id}}/followers" }
        },
        {
          "name": "Quem o usuário segue",
          "request": { "method": "GET", "url": "{{base_url}}/users/{{target_user_id}}/following" }
        }
      ]
    },
    {
      "name": "Playlists",
      "item": [
        {
          "name": "Criar playlist",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/playlists",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Minha playlist\",\n  \"description\": \"Vídeos favoritos\",\n  \"isPublic\": true\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const body = pm.response.json();",
                  "    pm.collectionVariables.set('playlist_id', body.data.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Minhas playlists",
          "request": { "method": "GET", "url": "{{base_url}}/my-playlists" }
        },
        {
          "name": "Detalhes da playlist",
          "request": { "method": "GET", "url": "{{base_url}}/playlists/{{playlist_id}}" }
        },
        {
          "name": "Adicionar vídeo à playlist",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/playlists/{{playlist_id}}/videos",
            "body": { "mode": "raw", "raw": "{\n  \"videoId\": {{video_id}}\n}" }
          }
        },
        {
          "name": "Remover vídeo da playlist",
          "request": { "method": "DELETE", "url": "{{base_url}}/playlists/{{playlist_id}}/videos/{{video_id}}" }
        },
        {
          "name": "Excluir playlist",
          "request": { "method": "DELETE", "url": "{{base_url}}/playlists/{{playlist_id}}" }
        },
        {
          "name": "Status do vídeo nas minhas playlists",
          "request": { "method": "GET", "url": "{{base_url}}/videos/{{video_id}}/playlists-status" }
        }
      ]
    },
    {
      "name": "Busca",
      "item": [
        { "name": "Buscar vídeos e usuários", "request": { "method": "GET", "url": "{{base_url}}/search?q=teste" } }
      ]
    },
    {
      "name": "Notificações",
      "item": [
        { "name": "Listar notificações", "request": { "method": "GET", "url": "{{base_url}}/notifications" } },
        { "name": "Marcar como lida", "request": { "method": "POST", "url": "{{base_url}}/notifications/{{notification_id}}/read" } },
        { "name": "Contagem de não lidas", "request": { "method": "GET", "url": "{{base_url}}/notifications/unread-count" } }
      ]
    },
    {
      "name": "Denúncias",
      "item": [
        {
          "name": "Denunciar vídeo",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/videos/{{video_id}}/report",
            "body": { "mode": "raw", "raw": "{\n  \"reason\": \"Conteúdo impróprio\"\n}" }
          }
        }
      ]
    },
    {
      "name": "Admin",
      "description": "Requer um usuário com isAdmin = true (defina direto no banco para testar).",
      "item": [
        { "name": "Dashboard", "request": { "method": "GET", "url": "{{base_url}}/admin/dashboard" } },
        { "name": "Listar denúncias", "request": { "method": "GET", "url": "{{base_url}}/admin/reports" } },
        {
          "name": "Ação sobre denúncia",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/admin/reports/{{report_id}}/action",
            "body": { "mode": "raw", "raw": "{\n  \"action\": \"resolve\"\n}" }
          }
        },
        { "name": "Listar usuários", "request": { "method": "GET", "url": "{{base_url}}/admin/users" } },
        { "name": "Bloquear/desbloquear usuário", "request": { "method": "POST", "url": "{{base_url}}/admin/users/{{target_user_id}}/toggle-block" } },
        { "name": "Listar vídeos", "request": { "method": "GET", "url": "{{base_url}}/admin/videos" } },
        { "name": "Excluir vídeo (admin)", "request": { "method": "DELETE", "url": "{{base_url}}/admin/videos/{{video_id}}" } }
      ]
    },
    {
      "name": "Health Check",
      "item": [
        { "name": "Status da API", "request": { "method": "GET", "url": "{{base_url}}" } }
      ]
    }
  ]
}
